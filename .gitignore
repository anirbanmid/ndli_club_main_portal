# NDLI Club Main Portal — gitignore (Python + Node + env/secrets)

# --- env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/db.sqlite3
backend/staticfiles/

# --- runtime media (never source; never committed) ---
# backend/var/
backend/data/ is ONBOARDING_UPLOAD_ROOT + ROSTER_IMPORT_ROOT (settings.base):
# identity documents and student roster CSVs. Personal data belongs on the
# server only — one careless `git add -A` would push it into permanent git
# history. Guarded by tests/test_repo_gitignore_guard.py.
backend/var/
backend/data/

# --- Node ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# --- Playwright e2e artifacts (traces/screenshots/HTML report) ---
# Regenerated by `npx playwright test`; never source, never committed.
# No trailing slashes: git cannot type a not-yet-created path, so a
# directory-only pattern would let the first CI artifact slip through.
frontend/test-results
frontend/playwright-report
frontend/blob-report

# --- Docker ---
pgdata/

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# --- logs ---
*.log
