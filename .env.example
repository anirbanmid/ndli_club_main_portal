# NDLI Club Main Portal — environment variables.
# Copy to .env (`cp .env.example .env`) and edit. NEVER commit a real .env.
# Every variable below is read by backend/config/settings/* except the ones
# explicitly marked RESERVED (planned for later milestones).

# --- Django core ----------------------------------------------------------
# Selects the settings module. dev is the local default (SQLite fallback);
# prod REQUIRES DATABASE_URL (PostgreSQL) and refuses to start without it.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Secret key. REQUIRED in production (config.settings.prod refuses to start
# without it). Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# true/1/yes/on. Defaults to true in dev, forced false in prod.
DJANGO_DEBUG=true

# Comma-separated public hostnames (e.g. club.ndl.iitkgp.ac.in,localhost).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins trusted for CSRF (scheme+host, e.g. https://club.ndl.iitkgp.ac.in).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Comma-separated origins allowed for CORS (only needed for the Vite dev server;
# production is single-origin and needs no CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated "Name:email" pairs for admin error reporting (prod only).
DJANGO_ADMINS=

# --- Database -------------------------------------------------------------
# PostgreSQL URL. In dev: optional (defaults to SQLite backend/db.sqlite3).
# In prod: REQUIRED and must be postgres:// or postgresql://.
# docker-compose sets this automatically for the backend service.
DATABASE_URL=postgresql://ndli_club:ndli_club_dev_password@localhost:5432/ndli_club

# docker-compose only: credentials for the postgres service.
POSTGRES_DB=ndli_club
POSTGRES_USER=ndli_club
POSTGRES_PASSWORD=ndli_club_dev_password

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to true to use Redis as the Django cache backend (default: locmem).
# Forced to Redis in config.settings.prod.
USE_REDIS_CACHE=false

# --- Object storage (MinIO in dev / S3-compatible in prod) ----------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Private bucket; signed URLs only (see spec section 7.1).
MINIO_BUCKET=ndli-club-private
MINIO_USE_SSL=false

# --- Email / SMS (provider-agnostic adapters; console drivers in dev) -----
# EMAIL_BACKEND: any Django email backend; console prints to the dev server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@club.ndl.iitkgp.ac.in
# SMS backend adapter. console | mock | <provider>. Adapter delivered later.
SMS_BACKEND=console

# --- Logging --------------------------------------------------------------
# Python logging level: DEBUG, INFO, WARNING, ERROR. Logs must never contain
# PII, tokens or credentials (spec section 9).
LOG_LEVEL=INFO

# --- RESERVED (not read in M0; documented for later milestones) -----------
# OTP settings (rate limits, expiry) — milestone M1.
# SMS gateway credentials / DLT template IDs — notifications milestone.
# Certificate HMAC key + key id (kept OUT of the database) — milestone M3/M5.
# Sentry/DSN error tracking hook — observability milestone.
