# NDLI Club Main Portal — environment variables.
# Copy to .env (`cp .env.example .env`) and edit. NEVER commit a real .env.
# Every variable below is read by backend/config/settings/* except the ones
# explicitly marked RESERVED (planned for later milestones).

# --- Django core ----------------------------------------------------------
# Selects the settings module. dev is the local default (SQLite fallback);
# prod REQUIRES DATABASE_URL (PostgreSQL) and refuses to start without it.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Secret key. REQUIRED in production (config.settings.prod refuses to start
# without it). Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# true/1/yes/on. Defaults to true in dev, forced false in prod.
DJANGO_DEBUG=true

# Comma-separated public hostnames (e.g. club.ndl.iitkgp.ac.in,localhost).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins trusted for CSRF (scheme+host, e.g. https://club.ndl.iitkgp.ac.in).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Comma-separated origins allowed for CORS (only needed for the Vite dev server;
# production is single-origin and needs no CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated "Name:email" pairs for admin error reporting (prod only).
DJANGO_ADMINS=

# --- Database -------------------------------------------------------------
# PostgreSQL URL. In dev: optional (defaults to SQLite backend/db.sqlite3).
# In prod: REQUIRED and must be postgres:// or postgresql://.
# docker-compose sets this automatically for the backend service.
DATABASE_URL=postgresql://ndli_club:ndli_club_dev_password@localhost:5432/ndli_club

# docker-compose only: credentials for the postgres service.
POSTGRES_DB=ndli_club
POSTGRES_USER=ndli_club
POSTGRES_PASSWORD=ndli_club_dev_password

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to true to use Redis as the Django cache backend (default: locmem).
# Forced to Redis in config.settings.prod.
USE_REDIS_CACHE=false

# --- Object storage (MinIO in dev / S3-compatible in prod) ----------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Private bucket; signed URLs only (see spec section 7.1).
MINIO_BUCKET=ndli-club-private
MINIO_USE_SSL=false

# --- Email (THE ONLY verification channel in this product) ----------------
# EMAIL_BACKEND: any Django email backend; console prints to the dev server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@club.ndl.iitkgp.ac.in
# The ONE EmailProvider interface (apps.accounts.email_providers).
#   console  -> Django email backend (prints / locmem-captures). Dev + tests.
#   sendgrid -> the NDLI Club existing system's provider (M10 handover).
# Leave empty to auto-pick: sendgrid when SENDGRID_API_KEY is set, else console.
EMAIL_PROVIDER=
# SendGrid API key. EMPTY IN DEV/CI — configured before client delivery (M10).
# This is the ONLY secret this driver needs; never commit a real value.
SENDGRID_API_KEY=
# Absolute origin used to build the F2 welcome / F4 forgot-password links.
# The single-use token rides in the URL FRAGMENT, never the query string.
SITE_URL=http://localhost:8000
# SMS backend adapter. console | mock | <provider>. Adapter delivered later.
# ⚠️ SMS is NEVER a verification channel in this product (BRIEF_M1.md §2a,
# user decision 2026-10-17 23:13): no OTP / code / password ever travels by
# SMS. This adapter is reserved for later operational notifications only.
SMS_BACKEND=console

# --- Logging --------------------------------------------------------------
# Python logging level: DEBUG, INFO, WARNING, ERROR. Logs must never contain
# PII, tokens or credentials (spec section 9).
LOG_LEVEL=INFO

# --- M1 identity tuning (all optional; the defaults below are the spec) ---
# Email OTP (BRIEF_M1.md §2a): 6 digits, single-use, 10 min TTL,
# max 5 sends/hour/recipient, 5 verify attempts then a 15-minute lockout.
M1_OTP_TTL_SECONDS=600
M1_OTP_MAX_SENDS_PER_HOUR=5
M1_OTP_MAX_VERIFY_ATTEMPTS=5
M1_OTP_LOCKOUT_SECONDS=900
# Login rate limiting / lockout.
M1_LOGIN_IP_LIMIT=10
M1_LOGIN_IP_WINDOW_SECONDS=300
M1_LOGIN_ACCOUNT_LIMIT=5
M1_LOGIN_ACCOUNT_WINDOW_SECONDS=300
M1_LOGIN_LOCKOUT_SECONDS=900
# Forgot-password request throttle (F4).
M1_RESET_REQUEST_LIMIT=3
M1_RESET_REQUEST_WINDOW_SECONDS=3600
# Single-use link TTLs (A5): welcome 72h, forgot-password 30 min.
M1_WELCOME_TOKEN_TTL_SECONDS=259200
M1_RESET_TOKEN_TTL_SECONDS=1800
# Official Institutional Passkey (F5) lockout.
M1_PASSKEY_MAX_FAILURES=5
M1_PASSKEY_LOCKOUT_SECONDS=900
# Password policy (min length 10 + denylist; no expiry nagging).
M1_PASSWORD_MIN_LENGTH=10
# Security-header CSP override (see docs/SECURITY.md). Empty = built-in policy.
CONTENT_SECURITY_POLICY=

# --- RESERVED (not read in M1; documented for later milestones) -----------
# SMS gateway credentials / DLT template IDs — notifications milestone.
# Certificate HMAC key + key id (kept OUT of the database) — milestone M3/M5.
# Sentry/DSN error tracking hook — observability milestone.
